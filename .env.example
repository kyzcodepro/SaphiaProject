# ─────────────────────────────────────────────────────────────────────────────
#  Variables d'environnement
#  Copier ce fichier en `.env.local` et compléter les valeurs.
#  ⚠️ Ne jamais committer `.env.local` : il contient des clés secrètes.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publique du site, sans slash final. Sert aux URLs absolues (SEO, sitemap)
# et aux redirections de retour de paiement.
NEXT_PUBLIC_SITE_URL=https://www.saphia.fr

# ─── Calendly ────────────────────────────────────────────────────────────────
# Identifiant du compte : la partie après calendly.com/
# Exemple : https://calendly.com/saphia  →  saphia
NEXT_PUBLIC_CALENDLY_USERNAME=saphia

# ─── Stripe (paiement par carte bancaire) ────────────────────────────────────
# Dashboard Stripe → Développeurs → Clés API
# Format attendu : « sk_test_… » en test, « sk_live_… » en production.
STRIPE_SECRET_KEY=
# Dashboard Stripe → Développeurs → Webhooks → signature du endpoint
# URL du webhook : https://<domaine>/api/webhooks/stripe
# Format attendu : « whsec_… »
STRIPE_WEBHOOK_SECRET=

# ─── PayPal ──────────────────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" pour les tests, "live" en production
PAYPAL_ENVIRONMENT=sandbox

# ─── Emails transactionnels (Resend) ─────────────────────────────────────────
# resend.com → API Keys. Sans cette clé, les emails ne partent pas mais le site
# reste pleinement fonctionnel (les envois sont simplement journalisés).
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend.
EMAIL_FROM="Saphia <contact@saphia.fr>"
# Adresse qui reçoit les questionnaires, demandes de contact et notifications.
EMAIL_ADMIN=contact@saphia.fr

# ─── Analytics (facultatif) ──────────────────────────────────────────────────
# Plausible : sans cookie, aucun bandeau de consentement nécessaire.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 : dépose des cookies → affiche automatiquement le bandeau.
NEXT_PUBLIC_GA_ID=
